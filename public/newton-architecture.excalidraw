    {"id": "layer-api-label", "type": "text", "x": 40, "y": 295, "width": 300, "height": 24, "strokeColor": "#666666", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100, "text": "▸ API LAYER (Next.js Route Handlers)", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "middle"},
    {"id": "layer-api-box", "type": "rectangle", "x": 40, "y": 320, "width": 920, "height": 90, "strokeColor": "#000000", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "opacity": 100, "roundness": {"type": 3}},
    {"id": "api-routes", "type": "text", "x": 55, "y": 330, "width": 880, "height": 70, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100, "text": "POST /api/chat-audio  ← Voice (VAD → Whisper STT) + Canvas Shapes + Skill Context → Socratic Response\nPOST /api/chat         ← Text + Canvas Shapes → Socratic Response\nGET  /api/skills       ← Full skill tree with user mastery progress merged\nGET  /api/skills/recommendations  ← Next best skill (prerequisites + lowest mastery)\nPOST /api/skills/update  ← Update user mastery level after session\nPOST /api/tts           ← Deprecated (voice handled client-side via SpeechSynthesis)\nGET  /api/dashboard/*   ← Teacher dashboard (heatmap, interventions — needs DB connection)", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top"},

    {"id": "layer-db-label", "type": "text", "x": 40, "y": 440, "width": 300, "height": 24, "strokeColor": "#666666", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100, "text": "▸ DATA LAYER (Supabase / PostgreSQL)", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "middle"},
